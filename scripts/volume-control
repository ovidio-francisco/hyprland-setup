#!/bin/sh

sink="@DEFAULT_AUDIO_SINK@"

case "$1" in
    up)   wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+    || exit 1 ;;
    down) wpctl set-volume      @DEFAULT_AUDIO_SINK@ 5%-    || exit 1 ;;
    mute) wpctl set-mute        @DEFAULT_AUDIO_SINK@ toggle || exit 1 ;;
    *) exit 1 ;;
esac

# Refresh waybar
pkill -RTMIN+1 waybar

state=$(wpctl get-volume "$sink") || exit 1
vol=$(printf '%s\n' "$state" | awk '{printf "%.0f", $2 * 100}')



case "$state" in
    *"[MUTED]"*) val=0;    text="Volume muted"   ;;
    *)           val=$vol; text="Volume ${vol}%" ;;
esac


notify-send \
	-a volume \
	-h string:x-canonical-private-synchronous:volume \
	-r 999 \
	-t 200 \
	-h int:value:"$val" \
	"$text"


