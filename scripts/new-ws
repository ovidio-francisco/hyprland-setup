#!/usr/bin/env bash
set -euo pipefail

current_windows=$(hyprctl activeworkspace -j | jq -r '.windows')

if [[ "$current_windows" -eq 0 ]]; then
    total=$(hyprctl workspaces -j | jq 'length')

    if [[ "$total" -gt 1 ]]; then
        hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })'
    fi

    exit 0
fi

number=$(
    hyprctl workspaces -j |
        jq -r '.[].id | select(. > 0)' |
        sort -n |
        awk 'BEGIN { n = 1 } $1 == n { n++ } END { print n }'
)

hyprctl dispatch "hl.dsp.focus({ workspace = \"$number\" })"







